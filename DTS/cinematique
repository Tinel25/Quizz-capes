            },
            {
                question: "Quel type de chaîne de montagnes est l'Himalaya ?",
                options: [
                    "Une chaîne de subduction",
                    "Une chaîne de collision",
                    "Une chaîne de rift",
                    "Une chaîne volcanique"
                ],
                correct: 1,
                explanation: "L'Himalaya est une chaîne de collision, formée par la collision entre la plaque Indienne et la plaque Eurasienne."
            },
            {
                question: "Avant le XXème siècle, comment les géologues considéraient-ils la position des continents ?",
                options: [
                    "Ils pensaient que les continents étaient mobiles",
                    "Ils pensaient que les continents étaient en rotation",
                    "Ils considéraient les continents comme fixes",
                    "Ils n'avaient aucune théorie"
                ],
                correct: 2,
                explanation: "Jusqu'au début du XXème siècle, les géologues attribuaient aux continents une position fixe."
            },
            {
                question: "Selon Eduard Suess, quelle était l'origine des chaînes de montagnes ?",
                options: [
                    "Le déplacement des continents",
                    "Le refroidissement de la Terre entraînant une diminution de volume et une compression",
                    "Les volcans",
                    "Les impacts météoritiques"
                ],
                correct: 1,
                explanation: "Eduard Suess pensait que le refroidissement de la Terre entraînait une diminution de son volume, mettant la surface sous compression et créant les chaînes de montagnes."
            },
            {
                question: "Quelle était la conception de la Terre selon l'idée de 'Terre ridée' ?",
                options: [
                    "La Terre se dilate avec le temps",
                    "La Terre se refroidit, diminue de volume, créant des rides comme les montagnes",
                    "La Terre est parfaitement sphérique",
                    "La Terre est plate"
                ],
                correct: 1,
                explanation: "L'idée de Terre ridée suggérait qu'en se refroidissant, la Terre diminuait de volume, créant des 'rides' comme les chaînes de montagnes."
            },
            {
                question: "Qui a publié les premières théories sur la mobilité des continents entre 1912 et 1924 ?",
                options: [
                    "Charles Darwin",
                    "Alfred Wegener",
                    "Eduard Suess",
                    "Isaac Newton"
                ],
                correct: 1,
                explanation: "Alfred Wegener, astronome et climatologue, a publié ses théories sur la mobilité des continents entre 1912 et 1924."
            },
            {
                question: "Que signifie SIMA dans la théorie de Wegener ?",
                options: [
                    "Silicium-Aluminium",
                    "Silicium-Magnésium",
                    "Soufre-Magnésium",
                    "Sodium-Magnésium"
                ],
                correct: 1,
                explanation: "SIMA signifie Silicium-Magnésium, désignant la composition de la croûte océanique selon Wegener."
            },
            {
                question: "Que signifie SIAL dans la théorie de Wegener ?",
                options: [
                    "Silicium-Magnésium",
                    "Silicium-Aluminium",
                    "Sodium-Aluminium",
                    "Soufre-Aluminium"
                ],
                correct: 1,
                explanation: "SIAL signifie Silicium-Aluminium, désignant la composition de la croûte continentale selon Wegener."
            },
            {
                question: "Quel argument géologique Wegener a-t-il utilisé pour soutenir sa théorie ?",
                options: [
                    "La couleur des roches",
                    "Les similitudes entre les structures géologiques des continents",
                    "La température des océans",
                    "La vitesse de rotation de la Terre"
                ],
                correct: 1,
                explanation: "Wegener a observé des similitudes entre les structures géologiques de différents continents, comme la chaîne calédonienne entre l'Écosse, la Norvège et le nord du Canada."
            },
            {
                question: "Qu'est-ce qu'un bouclier en géologie ?",
                options: [
                    "Une zone volcanique active",
                    "Un morceau de croûte déformé il y a au minimum 1 Ga et qui n'a pas été déformé depuis",
                    "Une faille récente",
                    "Un océan peu profond"
                ],
                correct: 1,
                explanation: "Un bouclier est un morceau de croûte déformé il y a au minimum 1 milliard d'années et qui n'a pas été déformé depuis."
            },
            {
                question: "Pourquoi la théorie des 'ponts continentaux' a-t-elle été réfutée ?",
                options: [
                    "Car elle ne pouvait pas expliquer la distribution des fossiles continentaux communs",
                    "Car elle était trop complexe",
                    "Car elle ne correspondait pas aux observations géologiques",
                    "Car les océans ne pouvaient pas avoir disparu"
                ],
                correct: 0,
                explanation: "La théorie des ponts continentaux ne pouvait pas expliquer de manière satisfaisante la distribution des fossiles continentaux communs entre continents séparés."
            },
            {
                question: "Que sont les tillites ?",
                options: [
                    "Des roches volcaniques",
                    "Des roches poudreuses sédimentaires témoins de dépôts glaciaires",
                    "Des fossiles marins",
                    "Des cristaux de glace"
                ],
                correct: 1,
                explanation: "Les tillites sont des roches poudreuses sédimentaires causées par les glaciers et témoignent des dépôts glaciaires."
            },
            {
                question: "Comment appelle-t-on le supercontinent proposé par Wegener ?",
                options: [
                    "Gondwana",
                    "Laurasia",
                    "Pangée",
                    "Rodinia"
                ],
                correct: 2,
                explanation: "Wegener a proposé que les continents provenaient de la fragmentation d'un continent unique appelé la Pangée."
            },
            {
                question: "À quelle période géologique Wegener situe-t-il la Pangée ?",
